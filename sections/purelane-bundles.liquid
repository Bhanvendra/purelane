{% render 'purelane-styles' %}
{{ 'purelane-bundles.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tier_blocks = section.blocks | where: 'type', 'tier'
  assign anchor_id = section.settings.anchor_id | default: 'bundles'
-%}

<section class="pl-bundles" {% if anchor_id != blank %}id="{{ anchor_id | escape }}"{% endif %} data-section-id="{{ section.id }}">
  <div class="pl-wrap">

    {%- if section.settings.heading != blank -%}
      <div class="pl-glass pl-sec-pad" style="margin-bottom:16px">
        <div class="pl-panel-head" style="margin-bottom:0">
          {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
          <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
          {%- if section.settings.lede != blank -%}<p class="pl-lede" style="margin:0 auto">{{ section.settings.lede }}</p>{%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if tier_blocks.size > 0 -%}
      <div class="pl-tiers">
        {%- for block in tier_blocks -%}
          {%- assign bundle = block.settings.bundle_product -%}
          {%- if bundle != blank -%}
          {%- liquid
            assign pix = block.settings.tierpix_products
            assign variant = bundle.selected_or_first_available_variant
            assign qty = pix.size
            assign featured = block.settings.featured
            if qty == 0 and block.settings.quantity_fallback > 0
              assign qty = block.settings.quantity_fallback
            endif
            if qty > 0
              assign per_product = variant.price | divided_by: qty
            endif
          -%}
          <article class="pl-tier pl-glass{% if featured %} pl-tier--best{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}<span class="pl-tier__tag">{{ block.settings.tag }}</span>{%- endif -%}

            {%- if pix.size > 0 -%}
              <div class="pl-tierpix{% if pix.size >= 5 %} pl-tierpix--five{% endif %}" aria-hidden="true">
                {%- for product in pix limit: 5 -%}
                  {%- assign img = product.featured_image -%}
                  {%- if img -%}
                    {{ img | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', class: 'pl-tierpix__img' }}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="pl-tier__qty">{{ qty }}<small>Products</small></div>
            <div class="pl-tier__price">
              {{ variant.price | money }}
              {%- if variant.compare_at_price > variant.price -%}<s>{{ variant.compare_at_price | money }}</s>{%- endif -%}
            </div>
            {%- if per_product -%}
              <p class="pl-body-s" style="font-size:12px">Flat {{ per_product | money }} per product</p>
            {%- endif -%}

            {%- if block.settings.bullets != blank -%}
              {%- assign bullet_lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
              <ul class="pl-tier__list">
                {%- for line in bullet_lines -%}
                  {%- assign trimmed = line | strip -%}
                  {%- if trimmed != blank -%}
                    <li>{% render 'purelane-icon', name: 'check' %}{{ trimmed }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            <a class="pl-btn {% if featured %}pl-btn--primary{% else %}pl-btn--ghost{% endif %}" href="{{ block.settings.cta_link | default: bundle.url | default: '#' }}">
              {{ block.settings.cta_label | default: 'Build this box' }}
              {%- if featured %}{% render 'purelane-icon', name: 'arrow' %}{% endif -%}
            </a>
          </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "tag": "section",
  "class": "pl-bundles-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor ID",
      "default": "bundles",
      "info": "Used for in-page links (e.g. #bundles)."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle tier",
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "product",
          "id": "bundle_product",
          "label": "Bundle product",
          "info": "Price and compare-at price come from this product's price."
        },
        {
          "type": "product_list",
          "id": "tierpix_products",
          "label": "Products shown in this tier (also sets the quantity)",
          "limit": 5
        },
        {
          "type": "range",
          "id": "quantity_fallback",
          "label": "Quantity to display if no products are picked above",
          "min": 0,
          "max": 10,
          "default": 0
        },
        {
          "type": "textarea",
          "id": "bullets",
          "label": "Feature bullets (one per line)",
          "default": "Pick any two products\nFree shipping across India"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Button label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Button link",
          "info": "Defaults to the bundle product page if left blank."
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight as most popular",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Purelane Bundles",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter" } },
        { "type": "tier", "settings": { "tag": "Most popular", "featured": true } },
        { "type": "tier", "settings": { "tag": "Whole home" } }
      ]
    }
  ]
}
{% endschema %}
