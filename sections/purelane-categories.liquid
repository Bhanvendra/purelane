{% render 'purelane-styles' %}
{{ 'purelane-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign cat_blocks = section.blocks | where: 'type', 'category'
  assign anchor_id = section.settings.anchor_id | default: 'categories'
-%}

<section class="pl-sec pl-categories pl-rv" {% if anchor_id != blank %}id="{{ anchor_id | escape }}"{% endif %} data-pl-scene="4" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-panel-head">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading | default: 'Find the right bundle for you' }}</h2>
    </div>
    {%- if cat_blocks.size > 0 -%}
      <div class="pl-cats">
        {%- for block in cat_blocks -%}
          <a class="pl-glass pl-cat pl-rv{% if forloop.index > 1 %} pl-rv--d{{ forloop.index | minus: 1 }}{% endif %}" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
            <span class="pl-cat__ph">
              {%- if block.settings.product != blank -%}
                {% render 'purelane-product-media', product: block.settings.product, context: 'shot' %}
              {%- endif -%}
            </span>
            <span class="pl-cat__txt">
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.subtitle }}</p>
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Categories",
  "tag": "section",
  "class": "pl-categories-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "categories" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bundle categories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right bundle for you" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "product", "id": "product", "label": "Featured product image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Kitchen bundle" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Grease, dishes & more" },
        { "type": "text", "id": "link", "label": "Link", "default": "#combos" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Categories",
      "blocks": [
        { "type": "category", "settings": { "product": "kitchen-cleaner-foaming", "title": "Kitchen bundle", "subtitle": "Grease, dishes & more" } },
        { "type": "category", "settings": { "product": "non-toxic-toilet-cleaner", "title": "Bathroom bundle", "subtitle": "Deep clean & disinfect" } },
        { "type": "category", "settings": { "product": "laundry-detergent-non-toxic", "title": "Laundry bundle", "subtitle": "Softer, fresher wash" } },
        { "type": "category", "settings": { "product": "tap-cleaner-limescale-remover", "title": "Hard water bundle", "subtitle": "Melt away limescale" } }
      ]
    }
  ]
}
{% endschema %}
