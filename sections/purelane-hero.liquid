{% render 'purelane-styles' %}
{{ 'purelane-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-hero.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign heading_line_1 = section.settings.heading_line_1
  assign heading_line_2 = section.settings.heading_line_2
  assign highlight = section.settings.highlight_word
  assign lede = section.settings.lede
  assign badge_blocks = section.blocks | where: 'type', 'badge'
  assign stage_blocks = section.blocks | where: 'type', 'stage'
  assign anchor_id = section.settings.anchor_id | default: 'top'
-%}

<section
  class="pl-hero"
  {% if anchor_id != blank %}id="{{ anchor_id | escape }}"{% endif %}
  data-pl-scene="1"
  data-section-id="{{ section.id }}"
>
  <div class="pl-hero__grid pl-wrap">

    {%- if badge_blocks.size > 0 -%}
      <div class="pl-badges pl-glass-2 pl-rv pl-rv--in" aria-label="Product promises">
        {%- for block in badge_blocks -%}
          {%- assign badge_lines = block.settings.label | split: '|' -%}
          <div class="pl-badge" {{ block.shopify_attributes }}>
            <span class="pl-badge__icon">{% render 'purelane-icon', name: block.settings.icon %}</span>
            <span>
              {%- for line in badge_lines -%}
                {%- unless forloop.first -%}<br>{%- endunless -%}{{ line | strip }}
              {%- endfor -%}
            </span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="pl-hero__copy">
      <h1 class="pl-d1 pl-rv pl-rv--in">
        {{ heading_line_1 | escape }}{%- if heading_line_2 != blank -%}<br>{{ heading_line_2 | escape }}{%- endif -%}
        {%- if highlight != blank -%}<br><span class="pl-lime">{{ highlight | escape }}</span>{%- endif -%}
      </h1>

      <div class="pl-rule pl-rv pl-rv--d1" aria-hidden="true">
        <i></i>
        {% render 'purelane-icon', name: 'leaf' %}
        <i></i>
      </div>

      {%- if lede != blank -%}
        <p class="pl-lede pl-rv pl-rv--d2">{{ lede }}</p>
      {%- endif -%}

      <div class="pl-hero__cta pl-rv pl-rv--d3">
        {%- if section.settings.primary_label != blank -%}
          <a class="pl-btn pl-btn--primary" href="{{ section.settings.primary_link | default: '#shop' }}">
            {{ section.settings.primary_label }}
            {% render 'purelane-icon', name: 'arrow' %}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="pl-btn pl-btn--ghost" href="{{ section.settings.secondary_link | default: '#bundles' }}">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if badge_blocks.size > 0 -%}
        <div class="pl-badgestrip pl-rv pl-rv--d4">
          {%- for block in badge_blocks -%}
            <div class="pl-glass-2">
              {% render 'purelane-icon', name: block.settings.icon %}
              {{ block.settings.label | split: '|' | first | strip }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    {%- if stage_blocks.size > 0 -%}
      <div class="pl-hero__prod pl-rv pl-rv--d2" id="pl-heroProd-{{ section.id }}">
        <div class="pl-hstage" id="pl-hstage-{{ section.id }}">
          {%- for block in stage_blocks -%}
            {%- liquid
              assign products = block.settings.products
              assign bundle_product = block.settings.bundle_product
              assign slide_class = 'pl-hs' | append: forloop.index
            -%}
            <div class="pl-hslide {{ slide_class }}{% if forloop.first %} on{% endif %}" data-n="{{ forloop.index }}" {{ block.shopify_attributes }}>
              {%- for product in products limit: 3 -%}
                {%- liquid
                  assign delay_class = 'a'
                  if forloop.index == 2
                    assign delay_class = 'b'
                  elsif forloop.index == 3
                    assign delay_class = 'c'
                  endif
                -%}
                {% render 'purelane-product-media', product: product, context: 'hero', class: delay_class %}
              {%- endfor -%}

              {%- if bundle_product != blank -%}
                {%- assign variant = bundle_product.selected_or_first_available_variant -%}
                <div class="pl-glass-2 pl-ptag">
                  <span class="pl-lbl">{{ block.settings.label | default: bundle_product.title }}</span>
                  <span class="pl-val">
                    <strong>{{ variant.price | money }}</strong>
                    {%- if variant.compare_at_price > variant.price -%}
                      <s>{{ variant.compare_at_price | money }}</s>
                    {%- endif -%}
                  </span>
                  {%- if variant.compare_at_price > variant.price -%}
                    {%- assign savings = variant.compare_at_price | minus: variant.price -%}
                    {%- assign pct = savings | times: 100 | divided_by: variant.compare_at_price -%}
                    {%- if forloop.index == 1 and pct > 0 -%}
                      <span class="pl-cut">{{ pct }}% off</span>
                    {%- else -%}
                      <span class="pl-cut">Save {{ savings | money }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if stage_blocks.size > 1 -%}
          <div class="pl-hdots" role="tablist" aria-label="Product bundle preview">
            {%- for block in stage_blocks -%}
              <button type="button" class="{% if forloop.first %}on{% endif %}" role="tab" aria-selected="{{ forloop.first }}" aria-label="Show {{ forloop.index }} product{% if forloop.index != 1 %}s{% endif %}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "class": "pl-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor ID",
      "default": "top",
      "info": "Used for in-page links (e.g. #top). Leave blank to disable."
    },
    {
      "type": "text",
      "id": "heading_line_1",
      "label": "Heading line 1",
      "default": "Clean"
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2",
      "default": "That"
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Highlighted word (accent colour)",
      "default": "Lasts"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Supporting text",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Promise badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "spark", "label": "Spark / clean" }
          ],
          "default": "leaf"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Plant powered",
          "info": "Use | for a line break in the desktop badge rail (e.g. Plant|powered)."
        }
      ]
    },
    {
      "type": "stage",
      "name": "Product stage",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Tag label",
          "default": "Single bottle"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products to show (up to 3)",
          "limit": 3
        },
        {
          "type": "product",
          "id": "bundle_product",
          "label": "Product to price this stage from",
          "info": "Price and compare-at price shown on the tag come from this product's price."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        { "type": "badge", "settings": { "icon": "leaf", "label": "Plant|powered" } },
        { "type": "badge", "settings": { "icon": "shield", "label": "Safe for|kids & pets" } },
        { "type": "badge", "settings": { "icon": "spark", "label": "Zero harsh|chemicals" } },
        { "type": "stage", "settings": { "label": "Single bottle" } },
        { "type": "stage", "settings": { "label": "Any 2 products" } },
        { "type": "stage", "settings": { "label": "Any 3 products" } }
      ]
    }
  ]
}
{% endschema %}
