{% render 'purelane-styles' %}
{{ 'purelane-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign ingredient_blocks = section.blocks | where: 'type', 'ingredient'
  assign anchor_id = section.settings.anchor_id | default: 'ingredients'
-%}

<section class="pl-sec pl-ingredients pl-rv" {% if anchor_id != blank %}id="{{ anchor_id | escape }}"{% endif %} data-pl-scene="2" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad">
      <div class="pl-panel-head">
        <h2 class="pl-d2">{{ section.settings.heading | default: 'Sourced from nature' }}</h2>
        <div class="pl-rule" aria-hidden="true"><i></i>{% render 'purelane-icon', name: 'leaf' %}<i></i></div>
      </div>
      {%- if ingredient_blocks.size > 0 -%}
        <div class="pl-ing">
          {%- for block in ingredient_blocks -%}
            <div class="pl-ing-i" {{ block.shopify_attributes }}>
              <div class="pl-ing-art">{% render 'purelane-ingredient-art', type: block.settings.art_type %}</div>
              <h4>{{ block.settings.title }}</h4>
              <p>{{ block.settings.description }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Ingredients",
  "tag": "section",
  "class": "pl-ingredients-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "ingredients" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sourced from nature" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "select",
          "id": "art_type",
          "label": "Illustration",
          "options": [
            { "value": "coconut", "label": "Coconut" },
            { "value": "orange", "label": "Orange peel" },
            { "value": "soapnut", "label": "Soap nut" },
            { "value": "neem", "label": "Neem" },
            { "value": "lemongrass", "label": "Lemongrass" }
          ],
          "default": "coconut"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Coconut" },
        { "type": "text", "id": "description", "label": "Description", "default": "Plant-derived cleansers that lift grease" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "art_type": "coconut", "title": "Coconut", "description": "Plant-derived cleansers that lift grease" } },
        { "type": "ingredient", "settings": { "art_type": "orange", "title": "Orange peel", "description": "Natural degreaser and fresh citrus lift" } },
        { "type": "ingredient", "settings": { "art_type": "soapnut", "title": "Soap nut", "description": "A traditional plant foaming agent" } },
        { "type": "ingredient", "settings": { "art_type": "neem", "title": "Neem", "description": "Time-tested antibacterial from the tree" } },
        { "type": "ingredient", "settings": { "art_type": "lemongrass", "title": "Lemongrass", "description": "Clean fragrance with nothing synthetic" } }
      ]
    }
  ]
}
{% endschema %}
