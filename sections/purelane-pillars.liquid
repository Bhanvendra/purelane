{% render 'purelane-styles' %}
{{ 'purelane-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign pillar_blocks = section.blocks | where: 'type', 'pillar'
  assign anchor_id = section.settings.anchor_id | default: 'how'
-%}

<section class="pl-sec pl-pillars-section pl-rv" {% if anchor_id != blank %}id="{{ anchor_id | escape }}"{% endif %} data-pl-scene="2" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    {%- if pillar_blocks.size > 0 -%}
    <div class="pl-pillars">
      {%- for block in pillar_blocks -%}
        <article class="pl-glass pl-pillar pl-rv{% if forloop.index > 1 %} pl-rv--d{{ forloop.index | minus: 1 }}{% endif %}" {{ block.shopify_attributes }}>
          <span class="pl-pillar__icon">{% render 'purelane-icon', name: block.settings.icon %}</span>
          <h3 class="pl-d3">{{ block.settings.heading }}</h3>
          <p class="pl-body-s">{{ block.settings.body }}</p>
          {%- if block.settings.link_label != blank -%}
            <a class="pl-btn pl-btn--ghost pl-btn--sm" href="{{ block.settings.link_url | default: '#' }}">{{ block.settings.link_label }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Pillars",
  "tag": "section",
  "class": "pl-pillars-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "how" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "foam", "label": "Foam" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "foam"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Less scrubbing" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
        { "type": "text", "id": "link_url", "label": "Link URL", "default": "#shop" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Pillars",
      "blocks": [
        { "type": "pillar", "settings": { "icon": "foam", "heading": "Less scrubbing", "link_url": "#shop" } },
        { "type": "pillar", "settings": { "icon": "shield", "heading": "Clean ingredients", "body": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.", "link_url": "#ingredients" } },
        { "type": "pillar", "settings": { "icon": "heart", "heading": "Safe around everyone", "body": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.", "link_url": "#proof" } }
      ]
    }
  ]
}
{% endschema %}
