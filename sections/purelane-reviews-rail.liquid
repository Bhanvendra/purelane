{% render 'purelane-styles' %}
{{ 'purelane-reviews-rail.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign anchor_id = section.settings.anchor_id | default: 'reviews'
-%}

<section class="pl-revband pl-rv" {% if anchor_id != blank %}id="{{ anchor_id | escape }}"{% endif %} data-pl-scene="1" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-revhead">
      {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
      {%- if section.settings.aggregate_rating != blank -%}
        <span class="pl-agg">
          <span class="pl-st" aria-hidden="true">{% render 'purelane-icon', name: 'star' %}{% render 'purelane-icon', name: 'star' %}{% render 'purelane-icon', name: 'star' %}{% render 'purelane-icon', name: 'star' %}{% render 'purelane-icon', name: 'star' %}</span>
          <b>{{ section.settings.aggregate_rating }}</b> from {{ section.settings.aggregate_review_count }} reviews
        </span>
      {%- endif -%}
      {%- if section.settings.aggregate_homes != blank -%}
        <span class="pl-agg">Loved by <b>{{ section.settings.aggregate_homes }}</b> homes</span>
      {%- endif -%}
    </div>
  </div>

  {%- if review_blocks.size > 0 -%}
    <div class="pl-revrail" aria-label="Customer reviews">
      <div class="pl-revtrack">
        {%- comment -%} Render the set twice, back-to-back, for a seamless CSS marquee. {%- endcomment -%}
        {%- for pass in (1..2) -%}
          {%- for block in review_blocks -%}
            <article class="pl-glass-2 pl-rcard" {% if pass == 2 %}aria-hidden="true" tabindex="-1"{% endif %} {% if pass == 1 %}{{ block.shopify_attributes }}{% endif %}>
              <div class="pl-st" aria-hidden="true">
                {%- assign stars = block.settings.rating | default: 5 -%}
                {%- for i in (1..5) -%}
                  {%- if i <= stars -%}{% render 'purelane-icon', name: 'star' %}{%- endif -%}
                {%- endfor -%}
              </div>
              <h5>{{ block.settings.heading }}</h5>
              <p>{{ block.settings.quote }}</p>
              <div class="pl-who">
                {% render 'purelane-icon', name: 'check' %}
                <b>{{ block.settings.name }}</b>
                {%- if block.settings.product != blank -%}<span>· {{ block.settings.product.title }}</span>{%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "tag": "section",
  "class": "pl-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor ID",
      "default": "reviews",
      "info": "Used for in-page links (e.g. #reviews)."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "aggregate_rating",
      "label": "Aggregate rating",
      "default": "4.8",
      "info": "No native storefront field holds a site-wide review average. If you run a reviews app, copy its aggregate rating here (or wire it to that app's metafield); otherwise update by hand."
    },
    {
      "type": "text",
      "id": "aggregate_review_count",
      "label": "Aggregate review count",
      "default": "8,000+"
    },
    {
      "type": "text",
      "id": "aggregate_homes",
      "label": "Homes served",
      "default": "12 lakh+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "default": 5
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Headline",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Customer name",
          "default": "Anita"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product mentioned (optional)"
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Purelane Reviews Rail",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "heading": "Best dishwash ever", "name": "Priya", "quote": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched." } },
        { "type": "review", "settings": { "heading": "Great product, great packaging", "name": "Sunita", "quote": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic." } },
        { "type": "review", "settings": { "heading": "Dog friendly", "name": "Rohit S.", "quote": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since." } }
      ]
    }
  ]
}
{% endschema %}
