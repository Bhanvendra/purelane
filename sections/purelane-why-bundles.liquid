{% render 'purelane-styles' %}
{{ 'purelane-content.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign anchor_id = section.settings.anchor_id | default: 'whybundles'
-%}

<section class="pl-sec pl-whybundles pl-rv" {% if anchor_id != blank %}id="{{ anchor_id | escape }}"{% endif %} data-pl-scene="4" data-section-id="{{ section.id }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad">
      <div class="pl-panel-head">
        {%- if section.settings.kicker != blank -%}<span class="pl-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 class="pl-d2" style="margin-top:12px">{{ section.settings.heading | default: 'Why bundles beat buying single' }}</h2>
      </div>
      {%- if benefit_blocks.size > 0 -%}
        <div class="pl-wb">
          {%- for block in benefit_blocks -%}
            <div class="pl-wb-i" {{ block.shopify_attributes }}>
              <span class="pl-wb-ci">{% render 'purelane-icon', name: block.settings.icon %}</span>
              <h4>{{ block.settings.heading }}</h4>
              <p>{{ block.settings.body }}</p>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Why Bundles",
  "tag": "section",
  "class": "pl-whybundles-section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "whybundles" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The smarter way to shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why bundles beat buying single" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "percent", "label": "Percent" },
            { "value": "ticket", "label": "Flat price" },
            { "value": "star-badge", "label": "Star" },
            { "value": "truck", "label": "Shipping" }
          ],
          "default": "percent"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Save up to 45%" },
        { "type": "text", "id": "body", "label": "Body", "default": "Versus buying the same products separately" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Why Bundles",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "percent", "heading": "Save up to 45%", "body": "Versus buying the same products separately" } },
        { "type": "benefit", "settings": { "icon": "ticket", "heading": "One flat price", "body": "No calculators, no comparing carts" } },
        { "type": "benefit", "settings": { "icon": "star-badge", "heading": "Curated by experts", "body": "Products picked to work well together" } },
        { "type": "benefit", "settings": { "icon": "truck", "heading": "Free shipping always", "body": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}
