{%- comment -%}
  Fixed gradient backdrop for the Purelane homepage.
  Crossfades between four scenes as the user scrolls (see purelane-homepage.js).
{%- endcomment -%}
<div class="pl-scenes" id="pl-scenes" data-d="1" aria-hidden="true">
  <div class="pl-scene pl-s1 on"></div>
  <div class="pl-scene pl-s2"></div>
  <div class="pl-scene pl-s3"></div>
  <div class="pl-scene pl-s4"></div>
  <div class="pl-waves" aria-hidden="true">
    <div class="pl-waves__layer pl-waves__a"></div>
    <div class="pl-waves__layer pl-waves__b"></div>
  </div>
  <div class="pl-vig"></div>
</div>
